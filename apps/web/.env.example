# --- Database (Supabase Postgres, used by Prisma) ---
# Pooled connection: used by the app at runtime
DATABASE_URL=
# Direct connection: used by "prisma migrate"
DIRECT_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this in the mobile app or in Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Image storage (AWS S3), needed once image upload is built ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Google Maps (server-side use, e.g. geocoding) ---
GOOGLE_MAPS_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
