# BiteGo mobile (Expo + React Native) - environment variables

#
# WARNING: every variable starting with EXPO_PUBLIC_ is bundled INTO the app
# and can be read by anyone who installs it. Only put public values here.
# Never add the Supabase service-role key, database URLs or AWS keys.

# --- Backend API (apps/web) ---
# On a physical phone "localhost" will NOT work. Use your computer's LAN IP,
# e.g. http://192.168.1.10:3000 (phone and computer on the same Wi-Fi).
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Supabase (anon key is safe ONLY if Row Level Security is enabled) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps (restrict this key to the Android package name + SHA-1) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
